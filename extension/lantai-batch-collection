#!/usr/bin/env bash
set -euo pipefail

# lantai-about: Add or remove many items from a collection
usage() {
  cat <<'EOF'
Usage: lantai batch-collection [--remove] [--all] COLLECTION [--] [TERM...]

Change collection membership for several items at once. TERMs are the
`lantai list` query language; put them after `--` if any of them starts with
`-`. By default the matching items are offered in the picker and only the ones
selected there are changed.

  --remove   take the items out of COLLECTION instead of putting them in
  --all      skip the picker and change every matching item
EOF
}

remove=false
apply_to_all=false
while (($# > 0)); do
  case $1 in
    --remove)
      remove=true
      shift
      ;;
    --all)
      apply_to_all=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if (($# == 0)); then
  usage >&2
  exit 2
fi
collection=$1
shift
if (($# > 0)) && [[ $1 == "--" ]]; then
  shift
fi
terms=("$@")

command -v jq >/dev/null 2>&1 || {
  echo "lantai batch-collection: jq is required" >&2
  exit 127
}

export LANTAI="${LANTAI:-lantai}"
# `lantai` only exports LANTAI_CONFIG when --config was passed, and bash 3.2
# treats an empty array as unset under `set -u`, hence the guarded expansions.
lantai_args=()
if [[ -n ${LANTAI_CONFIG:-} ]]; then
  lantai_args+=(--config "$LANTAI_CONFIG")
fi

selection_file=$(mktemp "${TMPDIR:-/tmp}/lantai-batch-collection.XXXXXX")
trap 'rm -f "$selection_file"' EXIT

# The picker returns whole items rather than identifiers so that the UUID check
# below can tell an entry with no UUID from one falling back to its key.
if $apply_to_all; then
  "$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} list -- \
    ${terms[@]+"${terms[@]}"} >"$selection_file"
else
  "$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} pick -- \
    ${terms[@]+"${terms[@]}"} >"$selection_file"
fi

if [[ ! -s $selection_file ]]; then
  echo "Nothing selected." >&2
  exit 0
fi
count=$(jq 'length' "$selection_file")
if ((count == 0)); then
  echo "No matching items." >&2
  exit 0
fi

if jq -e 'any(.[]; .uuid == null)' "$selection_file" >/dev/null; then
  echo "lantai batch-collection: refusing to change an item with no UUID; run lantai format first" >&2
  exit 2
fi

if $remove; then
  action=remove
  preposition=from
  past=Removed
else
  action=add
  preposition=to
  past=Added
fi

while IFS= read -r -d '' uuid; do
  "$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} collection "$action" \
    "$uuid" "$collection" --json >/dev/null
done < <(jq -j '.[] | .uuid, "\u0000"' "$selection_file")

printf "%s %d item(s) %s '%s'.\n" "$past" "$count" "$preposition" "$collection"
