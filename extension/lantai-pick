#!/usr/bin/env bash
set -euo pipefail

# lantai-about: Interactively pick items or attachments
usage() {
  cat <<'EOF'
Usage: lantai pick [--id-only] [--attachments] [--] [TERM...]

Fuzzy-select one or more items with fzf. TERMs are the `lantai list` query
language; put them after `--` if any of them starts with `-`.

  --id-only       write each selection's UUID (or citation key) instead of JSON
  --attachments   pick attachments rather than items

By default the selected items are written to stdout as a JSON array, in
bibliography order. With --attachments each element is an object with
item_uuid, citation_key, and the attachment. Selecting nothing writes nothing
and succeeds.

Typing matches whole words, against the complete citation key, author list,
title, and collections even where a row abbreviates them. Prefix a word with
' for a loose fuzzy match instead.

Inside the picker:
  TAB / shift-TAB           add or remove a selection
  alt-a alt-k alt-u alt-t   match against everything / key / author / title
  alt-y alt-e alt-l alt-r   sort by year / key / title / bibliography order
  alt-c                     narrow to one collection, or back to all of them
EOF
}

id_only=false
attachments=false
terms=()
while (($# > 0)); do
  case $1 in
    --id-only)
      id_only=true
      shift
      ;;
    --attachments)
      attachments=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      terms=("$@")
      break
      ;;
    *)
      # Anything that is not one of our own flags starts the query, so the
      # common case needs no `--`.
      terms=("$@")
      break
      ;;
  esac
done

for dependency in jq fzf; do
  command -v "$dependency" >/dev/null 2>&1 || {
    echo "lantai pick: $dependency is required" >&2
    exit 127
  }
done

export LANTAI="${LANTAI:-lantai}"
# `lantai` only exports LANTAI_CONFIG when --config was passed, so an unset
# variable means "the default configuration", not "none". Bash 3.2 treats an
# empty array as unset under `set -u`, hence the guarded expansions below.
lantai_args=()
if [[ -n ${LANTAI_CONFIG:-} ]]; then
  lantai_args+=(--config "$LANTAI_CONFIG")
fi

workdir=$(mktemp -d "${TMPDIR:-/tmp}/lantai-pick.XXXXXX")
trap 'rm -rf "$workdir"' EXIT

cache=$workdir/items.json
rows=$workdir/rows.jq
preview=$workdir/preview.jq
"$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} list -- ${terms[@]+"${terms[@]}"} >"$cache"
if [[ $(jq 'length' "$cache") -eq 0 ]]; then
  exit 0
fi

# Shared by both row programs: display helpers, and the collection filter,
# which follows Lantai's own nesting rule so that narrowing to `Projects` also
# keeps `Projects/IfT`.
common=$(
  cat <<'EOF'
def clean: (. // "") | tostring | gsub("[\\t\\r\\n]+"; " ");
def fit($width): clean
  | if ($width < 1) then ""
    elif (length > $width) then .[0:$width - 1] + "…"
    else . + ((" " * ($width - length)) // "") end;
def width($name): env[$name] | tonumber;
def segments: ascii_downcase | split("/")
  | map(sub("^\\s+"; "") | sub("\\s+$"; "")) | map(select(length > 0));
def under($filter): ($filter | segments) as $want
  | if ($want | length) == 0 then true
    else any(.collections[]?; segments as $have
      | ($have | length) >= ($want | length) and $have[0:($want | length)] == $want)
    end;
EOF
)

# Rows carry their index into the cache, so re-sorting or narrowing the display
# never disturbs the preview or the final output. Displayed columns are padded
# to a fixed width here rather than left to the terminal's tab stops, which is
# what keeps them lined up.
if $attachments; then
  {
    printf '%s\n' "$common"
    cat <<'EOF'
($collection | rtrimstr("\n")) as $only
| to_entries
| map(select(.value | under($only)))
| .[] as $entry
| $entry.value.attachments
| to_entries[]
| [
    ($entry.key | tostring),
    (.key | tostring),
    ($entry.value.uuid // $entry.value.citation_key),
    ($entry.value.title | fit(width("LANTAI_PICK_W_TITLE"))),
    ((.value.title // "") | fit(width("LANTAI_PICK_W_ATTACHMENT"))),
    (.value.media_type | fit(width("LANTAI_PICK_W_MEDIA"))),
    ($entry.value.citation_key | clean),
    (.value.path | clean)
  ]
| @tsv
EOF
  } >"$rows"
  cat >"$preview" <<'EOF'
def clean: (. // "") | tostring;
def dim: "\u001b[2m" + . + "\u001b[0m";
def bold: "\u001b[1m" + . + "\u001b[0m";
def caption($name): ($name + ((" " * (12 - ($name | length))) // "")) | dim;
.[$item] as $item
| $item.attachments[$attachment] as $file
| ($item.title // $item.citation_key | bold),
  "",
  (caption("item") + " " + $item.citation_key),
  (caption("attachment") + " " + ($file.title // "—")),
  (caption("type") + " " + $file.media_type),
  (caption("path") + " " + $file.path),
  (if $file.uuid == null
   then caption("managed") + " no — the file is referenced where it lies"
   else empty end)
EOF
else
  {
    printf '%s\n' "$common"
    # Keep the year rule in step with `year_of` in src/query.rs.
    cat <<'EOF'
def field($name): (first(.fields[]? | select(.name | ascii_downcase == $name) | .value)) // "";
def year: [field("year"), field("date")]
  | map(capture("^\\s*(?<digits>[0-9]+)").digits)
  | (.[0] // "");
def trim: sub("^\\s+"; "") | sub("\\s+$"; "");
# "Family, Given" and "Given Family" are both ordinary BibLaTeX spellings.
def parts:
  (if test(",")
   then (split(",") | {family: .[0], given: (.[1:] | join(","))})
   else (([splits("\\s+")] | map(select(length > 0))) as $words
     | if ($words | length) <= 1
       then {family: ($words[0] // ""), given: ""}
       else {family: $words[-1], given: ($words[0:-1] | join(" "))} end)
   end)
  | {family: (.family | trim), given: (.given | trim)};
def initials: [splits("[\\s.]+")] | map(select(length > 0))
  | map(if test("-")
        then ([splits("-")] | map(select(length > 0)) | map(.[0:1]) | join(".-")) + "."
        else .[0:1] + "." end)
  | join(" ");
def full_name: parts | if .given == "" then .family else .family + ", " + .given end;
def short_name: parts | if .given == "" then .family else .family + ", " + (.given | initials) end;
# Given names in full if they fit, abbreviated if they do not, and only then
# fewer authors. The complete list is a hidden column, so shortening the
# display never shortens what matching sees.
def people($width): field("author")
  | (if . == "" then [] else [splits("\\s+and\\s+")] end)
  | . as $all
  | ($all | length) as $total
  | ([($all | map(full_name) | join("; ")), ($all | map(short_name) | join("; "))]
     + [range($total - 1; 0; -1)
        | ($all[0:.] | map(short_name) | join("; ")) + "; et al."]
     | map(select(length <= $width)) | first)
    // ($all[0:1] | map(short_name) | join("; "));
($sort | rtrimstr("\n")) as $order
| ($collection | rtrimstr("\n")) as $only
| to_entries
| map(select(.value | under($only)))
| (if $order == "year" then sort_by(.value | year | (tonumber? // 999999))
   elif $order == "key" then sort_by(.value.citation_key | ascii_downcase)
   elif $order == "title" then sort_by(.value.title // "" | ascii_downcase)
   else . end)
| .[]
| .key as $index
| .value as $item
| width("LANTAI_PICK_W_PEOPLE") as $people
| [
    ($index | tostring),
    ($item.uuid // $item.citation_key),
    ($item | year | fit(4)),
    ($item | people($people) | fit($people)),
    ($item.title | fit(width("LANTAI_PICK_W_TITLE"))),
    ($item.citation_key | clean),
    ($item | field("author") | clean),
    ($item.title | clean),
    (($item.collections // []) | join("; ") | clean)
  ]
| @tsv
EOF
  } >"$rows"
  # A record reads as a labelled list, not as the JSON the machine-facing
  # output uses. Fields Lantai surfaces elsewhere are not repeated, and the
  # abstract goes last so it never pushes the identity off the top.
  cat >"$preview" <<'EOF'
def clean: (. // "") | tostring;
def dim: "\u001b[2m" + . + "\u001b[0m";
def bold: "\u001b[1m" + . + "\u001b[0m";
def caption($name): ($name + ((" " * (12 - ($name | length))) // "")) | dim;
# Lantai shows the identity, the collections, and the attachments in their own
# right, and the zotero-* fields are import bookkeeping nobody reads.
def shown: .name | ascii_downcase
  | . != "title" and . != "abstract" and . != "lantaiid" and . != "file"
    and . != "keywords" and (startswith("zotero-") | not);
.[$item] as $item
| ($item.title // $item.citation_key | bold),
  "",
  (caption("key") + " " + $item.citation_key),
  (caption("type") + " " + $item.entry_type),
  (if $item.uuid == null
   then caption("uuid") + " — (run lantai format)"
   else empty end),
  (if ($item.collections | length) > 0
   then caption("collections") + " " + ($item.collections | join(", "))
   else empty end),
  "",
  ($item.fields[]? | select(shown) | caption(.name | ascii_downcase) + " " + (.value | clean)),
  (if ($item.attachments | length) > 0
   then "", ($item.attachments[]
     | caption("attachment") + " " + ((.title // "—") + "  " + (.media_type | dim)))
   else empty end),
  (first($item.fields[]? | select(.name | ascii_downcase == "abstract"))
   | "", ("abstract" | dim), (.value | clean))
EOF
fi

# fzf runs bindings through a child shell, so the picker's state travels in the
# environment and in small files: nothing has to be escaped into the binding
# strings themselves, and every reload reads the current state rather than
# whatever was true when the binding was built.
export LANTAI_PICK_CACHE=$cache
export LANTAI_PICK_ROWS=$rows
export LANTAI_PICK_PREVIEW=$preview
export LANTAI_PICK_MATCH=$workdir/match
export LANTAI_PICK_SORT=$workdir/sort
export LANTAI_PICK_COLLECTION=$workdir/collection
export LANTAI_PICK_HEADER=$workdir/header.sh
export LANTAI_PICK_CHOOSE=$workdir/choose.sh
export LANTAI_PICK_RENDER=$workdir/render.sh
export LANTAI_PICK_MODE=$($attachments && echo attachments || echo items)
printf 'all\n' >"$LANTAI_PICK_MATCH"
printf 'source\n' >"$LANTAI_PICK_SORT"
: >"$LANTAI_PICK_COLLECTION"
# A user's login shell need not be POSIX-compatible; the bindings are.
export SHELL=/bin/sh

if $attachments; then
  cat >"$LANTAI_PICK_HEADER" <<'EOF'
#!/bin/sh
collection=any
[ -s "$LANTAI_PICK_COLLECTION" ] && collection=$(cat "$LANTAI_PICK_COLLECTION")
printf 'collection: %s\n' "$collection"
printf 'alt-c collection · TAB select\n'
EOF
else
  cat >"$LANTAI_PICK_HEADER" <<'EOF'
#!/bin/sh
collection=any
[ -s "$LANTAI_PICK_COLLECTION" ] && collection=$(cat "$LANTAI_PICK_COLLECTION")
printf 'match: %s   sort: %s   collection: %s\n' \
  "$(cat "$LANTAI_PICK_MATCH")" "$(cat "$LANTAI_PICK_SORT")" "$collection"
printf 'alt-a/k/u/t match · alt-y/e/l/r sort · alt-c collection · TAB select\n'
EOF
fi

# Collections are not a row column — an item can be in several, so the column
# was mostly noise. Narrowing to one is a nested picker instead, listing every
# collection the loaded items sit in, plus the ancestors those imply.
cat >"$LANTAI_PICK_CHOOSE" <<'EOF'
#!/bin/sh
chosen=$(
  {
    printf '%s\n' '(all collections)'
    jq -r '
      [.[] | .collections[]?]
      | map(split("/") as $parts | [range(1; ($parts | length) + 1) | $parts[0:.] | join("/")])
      | flatten
      | map(sub("^\\s+"; "") | sub("\\s+$"; ""))
      | map(select(length > 0))
      | unique_by(ascii_downcase)
      | sort_by(ascii_downcase)
      | .[]
    ' "$LANTAI_PICK_CACHE"
  } | fzf --prompt='Collection> ' --no-multi
) || exit 0
[ -n "$chosen" ] || exit 0
if [ "$chosen" = '(all collections)' ]; then
  : >"$LANTAI_PICK_COLLECTION"
else
  printf '%s\n' "$chosen" >"$LANTAI_PICK_COLLECTION"
fi
EOF
# Every displayed column is padded to a width derived from the terminal, and
# together they fill it exactly — which is what keeps the columns that exist
# only to be searched off the right-hand edge. fzf reports its own width to the
# commands it runs, so re-rendering on a resize re-pads to the new one.
cat >"$LANTAI_PICK_RENDER" <<'EOF'
#!/bin/sh
columns=${FZF_COLUMNS:-0}
if [ "$columns" -le 0 ]; then
  size=$( { stty size </dev/tty; } 2>/dev/null ) || size=
  [ -n "$size" ] && columns=${size##* } || columns=100
fi
[ "$columns" -ge 60 ] || columns=60
# fzf keeps two columns for the pointer and the multi-select marker, and one
# more for the scrollbar.
usable=$((columns - 3))

if [ "$LANTAI_PICK_MODE" = attachments ]; then
  LANTAI_PICK_W_MEDIA=16
  if [ "$usable" -ge 140 ]; then
    LANTAI_PICK_W_ATTACHMENT=24
  else
    LANTAI_PICK_W_ATTACHMENT=16
  fi
  LANTAI_PICK_W_TITLE=$((usable - LANTAI_PICK_W_ATTACHMENT - LANTAI_PICK_W_MEDIA - 2))
  export LANTAI_PICK_W_MEDIA LANTAI_PICK_W_ATTACHMENT LANTAI_PICK_W_TITLE
else
  if [ "$usable" -ge 150 ]; then
    LANTAI_PICK_W_PEOPLE=46
  elif [ "$usable" -ge 110 ]; then
    LANTAI_PICK_W_PEOPLE=32
  else
    LANTAI_PICK_W_PEOPLE=20
  fi
  # The year, and the separator after each of the three columns.
  LANTAI_PICK_W_TITLE=$((usable - 6 - LANTAI_PICK_W_PEOPLE))
  [ "$LANTAI_PICK_W_TITLE" -ge 24 ] || LANTAI_PICK_W_TITLE=24
  export LANTAI_PICK_W_PEOPLE LANTAI_PICK_W_TITLE
fi

exec jq -r --rawfile sort "$LANTAI_PICK_SORT" \
  --rawfile collection "$LANTAI_PICK_COLLECTION" \
  -f "$LANTAI_PICK_ROWS" "$LANTAI_PICK_CACHE"
EOF
chmod +x "$LANTAI_PICK_HEADER" "$LANTAI_PICK_CHOOSE" "$LANTAI_PICK_RENDER"

refresh='reload(sh "$LANTAI_PICK_RENDER")+transform-header(sh "$LANTAI_PICK_HEADER")'
scope() {
  printf 'alt-%s:change-nth(%s)+execute-silent(printf "%s\\n" > "$LANTAI_PICK_MATCH")+transform-header(sh "$LANTAI_PICK_HEADER")' \
    "$1" "$2" "$3"
}
order() {
  printf 'alt-%s:execute-silent(printf "%s\\n" > "$LANTAI_PICK_SORT")+%s' "$1" "$2" "$refresh"
}

fzf_args=(
  --multi
  --delimiter=$'\t'
  --prompt='Lantai> '
  --header-first
  --header="$(sh "$LANTAI_PICK_HEADER")"
  --bind="alt-c:execute(sh \"\$LANTAI_PICK_CHOOSE\")+$refresh"
  --bind="resize:$refresh"
  # Rows are long and much of what they match is not on screen, so a fuzzy
  # subsequence over all of it matches nearly everything and ranks it by
  # accident. Words are matched literally; a leading ' asks for fuzzy.
  --exact
  # The columns are padded above; let a tab occupy one cell rather than jumping
  # to the next tab stop, and keep every row anchored at the left edge so they
  # stay in line when a match is off to the right.
  --tabstop=1
  --no-hscroll
  # Below rather than beside: a row wants the width more than the record does,
  # and a record reads better wrapped at full width than in half of one.
  --preview-window='down,45%,wrap'
)
# Everything searchable has to be inside --with-nth, because fzf matches the
# string that produces, not the original line: a --nth pointing past it selects
# nothing at all. The trailing columns carry the citation key and the complete
# author list, title, and collections; they are searched but never seen,
# because the columns before them are padded to fill the terminal exactly.
# --nth is therefore counted from the first column --with-nth keeps.
if $attachments; then
  fzf_args+=(
    --with-nth=4..
    --nth=1..
    # fzf quotes a field placeholder before the shell sees it, so the index
    # reaches jq as an argument rather than inside the program text.
    --preview='jq -r --argjson item {1} --argjson attachment {2} -f "$LANTAI_PICK_PREVIEW" "$LANTAI_PICK_CACHE"'
  )
else
  fzf_args+=(
    --with-nth=3..
    --nth=1..
    --preview='jq -r --argjson item {1} -f "$LANTAI_PICK_PREVIEW" "$LANTAI_PICK_CACHE"'
    --bind="$(scope a '1..' all)"
    --bind="$(scope k 4 key)"
    --bind="$(scope u 5 author)"
    --bind="$(scope t 6 title)"
    --bind="$(order y year)"
    --bind="$(order e key)"
    --bind="$(order l title)"
    --bind="$(order r source)"
  )
fi

status=0
selection=$(sh "$LANTAI_PICK_RENDER" | fzf "${fzf_args[@]}") || status=$?

case $status in
  0) ;;
  1|130) exit 0 ;;
  *) exit "$status" ;;
esac
[[ -n $selection ]] || exit 0

if $attachments; then
  if $id_only; then
    printf '%s\n' "$selection" | cut -f3
  else
    printf '%s\n' "$selection" | cut -f1,2 |
      jq -R --slurpfile items "$cache" '
        (split("\t") | map(tonumber)) as $index
        | $items[0][$index[0]] as $item
        | {
            item_uuid: $item.uuid,
            citation_key: $item.citation_key,
            attachment: $item.attachments[$index[1]]
          }
      ' | jq -s .
  fi
else
  # Output follows the bibliography, not the order rows happened to be picked
  # in, so a selection means the same thing however it was made.
  indices=$(printf '%s\n' "$selection" | cut -f1 | sort -n -u)
  if $id_only; then
    printf '%s\n' "$indices" |
      jq -r --slurpfile items "$cache" \
        'tonumber as $index | $items[0][$index] | .uuid // .citation_key'
  else
    printf '%s\n' "$indices" |
      jq --slurpfile items "$cache" 'tonumber as $index | $items[0][$index]' |
      jq -s .
  fi
fi
