#!/usr/bin/env bash
set -euo pipefail

# lantai-about: Pick an attachment and open it
usage() {
  cat <<'EOF'
Usage: lantai open [--print] [--stdin] [--] [TERM...]

Fuzzy-select one or more attachments with fzf and open them with macOS `open`
or Linux `xdg-open`. TERMs are the `lantai list` query language; put them
after `--` if any of them starts with `-`.

  --print   write the resolved paths instead of opening them
  --stdin   read the selection as JSON on standard input instead of picking

Selecting several attachments opens all of them. Selecting none does nothing
and succeeds.

--stdin takes what either picker writes: an array of items opens every
attachment they have, and an array of attachment selections opens exactly
those. It takes no TERMs, because the selection is already made.

Typing matches whole words, against the complete citation key, author list,
title, and collections even where a row abbreviates them. Prefix a word with
' for a loose fuzzy match instead.

Inside the picker:
  TAB / shift-TAB           add or remove a selection
  alt-a alt-k alt-u alt-t   match against everything / key / author / title
  alt-y alt-e alt-l alt-r   sort by year / key / title / bibliography order
  alt-c                     narrow to one collection, or back to all of them

This is `lantai pick --attachments` with the opening step attached, so the
picker behaves identically.
EOF
}

print_only=false
from_stdin=false
terms=()
while (($# > 0)); do
  case $1 in
    --print)
      print_only=true
      shift
      ;;
    --stdin)
      from_stdin=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      terms=("$@")
      break
      ;;
    *)
      terms=("$@")
      break
      ;;
  esac
done

command -v jq >/dev/null 2>&1 || {
  echo "lantai open: jq is required" >&2
  exit 127
}

export LANTAI="${LANTAI:-lantai}"
# The picker is reached through `lantai` itself, so a locally overridden
# `lantai-pick` on PATH is the one that runs. LANTAI_LIBRARY is inherited, but
# LANTAI_CONFIG has to be re-stated as a flag: `lantai` only exports it when it
# was given one.
lantai_args=()
if [[ -n ${LANTAI_CONFIG:-} ]]; then
  lantai_args+=(--config "$LANTAI_CONFIG")
fi

if $from_stdin; then
  if ((${#terms[@]} > 0)); then
    echo "lantai open: --stdin takes no query terms" >&2
    exit 2
  fi
  selection=$(cat)
else
  selection=$(
    "$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} pick --attachments -- \
      ${terms[@]+"${terms[@]}"}
  )
fi
[[ -n $selection ]] || exit 0

# Both pickers describe an attachment, one wrapped in its item and one inside
# the item's list, so reduce either to the attachments themselves and let the
# rest of the script speak only of those. One item, as `lantai show` writes it,
# is the same thing without the array.
selection=$(printf '%s' "$selection" |
  jq '(if type == "array" then . else [.] end)
    | [.[] | if has("attachment") then .attachment else (.attachments[]?) end]')
if [[ $(printf '%s' "$selection" | jq 'length') -eq 0 ]]; then
  if $from_stdin; then
    echo "lantai open: the selection has no attachments." >&2
  fi
  exit 0
fi

# Managed attachments are recorded relative to the library, so those need the
# library directory. `check` reports that path alongside its findings, and
# opening a file does not depend on the library being intact — so ignore the
# exit status but not the diagnostics, which are the only clue when it fails
# outright.
library_directory=
if printf '%s' "$selection" | jq -e 'any(.[]; .path | startswith("/") | not)' >/dev/null; then
  report=$("$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} check --json) || true
  if [[ -z $report ]]; then
    echo "lantai open: could not determine the library path" >&2
    exit 1
  fi
  library=$(printf '%s' "$report" | jq -er '.library')
  library_directory=$(dirname -- "$library")
fi

resolve() {
  if [[ $1 == /* ]]; then
    printf '%s\n' "$1"
  else
    printf '%s\n' "$library_directory/$1"
  fi
}

open_file() {
  if [[ $(uname -s) == Darwin ]]; then
    command -v open >/dev/null 2>&1 || {
      echo "lantai open: open is required on macOS" >&2
      exit 127
    }
    open -- "$1"
  else
    command -v xdg-open >/dev/null 2>&1 || {
      echo "lantai open: xdg-open is required on this platform" >&2
      exit 127
    }
    xdg-open "$1"
  fi
}

while IFS= read -r -d '' attachment_path; do
  resolved_path=$(resolve "$attachment_path")
  if $print_only; then
    printf '%s\n' "$resolved_path"
  else
    open_file "$resolved_path"
  fi
done < <(printf '%s' "$selection" | jq -j '.[] | .path, "\u0000"')
