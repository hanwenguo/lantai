#!/usr/bin/env bash
set -euo pipefail

# lantai-about: Pick an attachment and open it
usage() {
  cat <<'EOF'
Usage: lantai open [--print] [--] [TERM...]

Pick attachments with `lantai pick --attachments` and open them with macOS
`open` or Linux `xdg-open`. TERMs are the `lantai list` query language; put
them after `--` if any of them starts with `-`.

  --print   write the resolved paths instead of opening them

Selecting several attachments opens all of them. Selecting none does nothing
and succeeds.
EOF
}

print_only=false
terms=()
while (($# > 0)); do
  case $1 in
    --print)
      print_only=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      terms=("$@")
      break
      ;;
    *)
      terms=("$@")
      break
      ;;
  esac
done

command -v jq >/dev/null 2>&1 || {
  echo "lantai open: jq is required" >&2
  exit 127
}

export LANTAI="${LANTAI:-lantai}"
# The picker is reached through `lantai` itself, so a locally overridden
# `lantai-pick` on PATH is the one that runs. LANTAI_LIBRARY is inherited, but
# LANTAI_CONFIG has to be re-stated as a flag: `lantai` only exports it when it
# was given one.
lantai_args=()
if [[ -n ${LANTAI_CONFIG:-} ]]; then
  lantai_args+=(--config "$LANTAI_CONFIG")
fi

selection=$(
  "$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} pick --attachments -- \
    ${terms[@]+"${terms[@]}"}
)
[[ -n $selection ]] || exit 0
if [[ $(printf '%s' "$selection" | jq 'length') -eq 0 ]]; then
  exit 0
fi

# Managed attachments are recorded relative to the library, so those need the
# library directory. `check` reports that path alongside its findings, and
# opening a file does not depend on the library being intact — so ignore the
# exit status but not the diagnostics, which are the only clue when it fails
# outright.
library_directory=
if printf '%s' "$selection" | jq -e 'any(.[]; .attachment.path | startswith("/") | not)' >/dev/null; then
  report=$("$LANTAI" ${lantai_args[@]+"${lantai_args[@]}"} check --json) || true
  if [[ -z $report ]]; then
    echo "lantai open: could not determine the library path" >&2
    exit 1
  fi
  library=$(printf '%s' "$report" | jq -er '.library')
  library_directory=$(dirname -- "$library")
fi

resolve() {
  if [[ $1 == /* ]]; then
    printf '%s\n' "$1"
  else
    printf '%s\n' "$library_directory/$1"
  fi
}

open_file() {
  if [[ $(uname -s) == Darwin ]]; then
    command -v open >/dev/null 2>&1 || {
      echo "lantai open: open is required on macOS" >&2
      exit 127
    }
    open -- "$1"
  else
    command -v xdg-open >/dev/null 2>&1 || {
      echo "lantai open: xdg-open is required on this platform" >&2
      exit 127
    }
    xdg-open "$1"
  fi
}

while IFS= read -r -d '' attachment_path; do
  resolved_path=$(resolve "$attachment_path")
  if $print_only; then
    printf '%s\n' "$resolved_path"
  else
    open_file "$resolved_path"
  fi
done < <(printf '%s' "$selection" | jq -j '.[] | .attachment.path, "\u0000"')
